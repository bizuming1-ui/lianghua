  if (!st) { body.innerHTML = '<div class="dim">连接中…</div>'; return; }
  if (!st.available) {
    chip.className = "chip"; chip.innerHTML = "<i></i>未启用"; gp.innerHTML = "";
    body.innerHTML = '<div class="dim" style="line-height:1.5">' + esc(st.reason || "AI 推理仅在 Kaggle(T4×2)版运行") + "</div>";
    return;
  }
  const llm = st.llm;
  chip.className = "chip " + (llm.up ? "open" : "");
  chip.innerHTML = "<i></i>" + (llm.up ? esc((llm.model || "LLM").replace("quant-llm", "在线")) + (llm.tps ? " · " + llm.tps + " tok/s" : "") : "大模型未就绪");
  gp.innerHTML = (st.gpus || []).map((g) => '<div class="gpu"><span>GPU' + g.i + "</span><div class='gb'><div style='width:" + Math.min(100, g.util) + "%'></div></div><b class='mono'>" + Math.round(g.util) + "%</b><span class='dim mono'>" + (g.memUsed / 1024).toFixed(1) + "/" + (g.memTotal / 1024).toFixed(0) + "G</span></div>").join("") || '<div class="dim">未检测到 GPU</div>';
  const lv = st.live && st.live[sel], d = st.decisions && st.decisions[sel], s = st.studies && st.studies[sel];
  let h = "";
  if (!llm.up) h += '<div class="warn">大模型未就绪:请先在 Kaggle 运行 Cell 0(双 T4 部署),就绪后此处自动变绿。</div>';
  if (lv && lv.running) h += '<div class="think"><b class="acc">AI 正在推理…</b> <span class="mono dim">' + lv.tokens + " tokens</span><div class='tt'>" + esc((lv.tail || "").slice(-380)) + "</div></div>";
  if (d) {
    if (d.error) h += '<div class="warn">分析失败:' + esc(d.error) + "</div>";
    else {
      const fin = d.finalAction;
      h += '<div class="dec"><span class="sig ' + fin + '">' + ACT[fin] + "</span> <span class='dim'>AI原判 " + ACT[d.action] + " · 置信 <b class='mono'>" + (d.confidence * 100).toFixed(0) + "%</b> · " + esc(d.strategy) + " · 持有≤" + d.horizonMin + "分 · 止损" + d.stopPct + "% 止盈" + d.targetPct + "%</span></div>";
      h += '<div class="thesis">' + esc(d.thesis) + "</div>";
      const bad = (d.gate.checks || []).filter((c) => !c.ok);
      h += '<div class="gate ' + (d.gate.pass ? "pass" : "fail") + '">数学闸门 ' + (d.gate.pass ? "✔ 通过" : "✘ 拦截:" + bad.slice(0, 2).map((c) => esc(c.name)).join(" / ")) + (d.exec ? " · " + esc(d.exec) : "") + "</div>";
      h += '<div class="dim" style="font-size:.66rem">' + fmtT(d.ts) + " · 耗时 " + d.latencyS + "s · " + d.tokens + " tokens</div>";
    }
  } else if (llm.up && !(lv && lv.running)) h += '<div class="dim">尚无决策,点击『立即分析』或等待自动轮询。</div>';
  if (s) {
    h += '<div class="stl">' + studyLine(s.intra, "日内") + "</div><div class='stl'>" + studyLine(s.daily, "日线") + "</div>";
    if (s.gap && s.gap.expected_remaining != null) h += "<div class='stl'>隔夜联动 β=" + s.gap.beta.toFixed(2) + " (t=" + s.gap.t.toFixed(1) + ", R²=" + s.gap.r2.toFixed(2) + ") 剩余预期 <b class='mono " + cls(s.gap.expected_remaining) + "'>" + (s.gap.expected_remaining * 100).toFixed(2) + "%</b></div>";
  }
  const sc = st.score; if (sc && sc.n) h += '<div class="dim" style="font-size:.66rem">AI复盘 ' + sc.n + " 条 · BUY命中 " + (sc.buy_rate == null ? "--" : (sc.buy_rate * 100).toFixed(0) + "%") + " · 净 " + (sc.avg_net_bp == null ? "--" : sc.avg_net_bp.toFixed(1) + "bp") + "</div>";
  body.innerHTML = h;
}
