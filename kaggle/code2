def build_state(since):
    now_ms = int(time.time() * 1000)
    with LOCK:
        acc = DB.execute("SELECT * FROM account WHERE id=1").fetchone()
        poss = DB.execute("SELECT * FROM positions").fetchall()
        st = DB.execute(
