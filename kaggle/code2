}
$("ai_more").onclick = openAI;
$("aim_close").onclick = () => $("aimodal").classList.remove("on");

setInterval(() => { $("clock").textContent = fmtT(Date.now()); }, 250);
loop();
aiLoop();
</script>
</body>
</html>
