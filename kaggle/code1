def http_json(url, timeout=8, headers=None, retries=2):
    err = None
    for i in range(retries + 1):
        try:
            h = dict(UA)
            h.update(headers or {})
            with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=timeout) as r:
