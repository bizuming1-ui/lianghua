    for (const tr of S.trades) {
      if (tr.symbol !== sel || tr.ts < t0 - 1500 || tr.ts > t1 + 2500) continue;
      const i = Math.max(0, Math.min(n - 1, Math.round(((tr.ts - t0) / Math.max(1, t1 - t0)) * (n - 1)))); const X = Xi(i), Yv = Y(tr.price), buy = tr.side === "BUY";
      x.fillStyle = buy ? colors.up : colors.dn; x.beginPath();
      if (buy) { x.moveTo(X, Yv + 3); x.lineTo(X - 7, Yv + 17); x.lineTo(X + 7, Yv + 17); } else { x.moveTo(X, Yv - 3); x.lineTo(X - 7, Yv - 17); x.lineTo(X + 7, Yv - 17); }
      x.closePath(); x.fill(); x.fillStyle = "#fff"; x.textAlign = "center"; x.font = "bold " + Math.round(0.7 * r) + "px sans-serif"; x.fillText(buy ? "买" : "卖", X, buy ? Yv + 13 : Yv - 12);
    }
  } else {
    x.strokeStyle = "#344256"; x.setLineDash([2, 5]); x.beginPath(); x.moveTo(L, Y(0)); x.lineTo(L + cw, Y(0)); x.stroke(); x.setLineDash([]);
    series.forEach((s) => { x.beginPath(); s.vals.forEach((v, i) => (i ? x.lineTo(Xi(i), Y(v)) : x.moveTo(Xi(i), Y(v)))); x.strokeStyle = CMP[s.code]; x.lineWidth = 2; x.stroke(); });
  }
  x.restore();
  // 最新价标签
  x.font = "bold " + Math.round(0.8 * r) + "px SF Mono,Menlo,Consolas,monospace"; x.textAlign = "left";
  series.forEach((s) => {
    const v = s.vals[n - 1], y = Y(v), col = mode === "single" ? (s.vals[n - 1] >= s.vals[0] ? colors.up : colors.dn) : CMP[s.code];
    x.strokeStyle = col; x.globalAlpha = 0.5; x.setLineDash([3, 3]); x.beginPath(); x.moveTo(L, y); x.lineTo(L + cw, y); x.stroke(); x.setLineDash([]); x.globalAlpha = 1;
    x.fillStyle = col; x.fillRect(L + cw, y - 0.8 * r, R - 0.2 * r, 1.6 * r); x.fillStyle = "#000";
    x.fillText(mode === "single" ? v.toFixed(q0.decimals) : s.code + " " + pct(v, 2), L + cw + 0.3 * r, y);
    x.beginPath(); x.arc(Xi(n - 1), y, 3.5, 0, 7); x.fillStyle = col; x.fill();
  });
  // 图例 / 十字光标
  x.font = Math.round(0.8 * r) + "px SF Mono,Menlo,Consolas,monospace"; x.textAlign = "left";
  if (mode === "compare") { let lx = L + 0.6 * r; series.forEach((s) => { x.fillStyle = CMP[s.code]; x.fillRect(lx, T + 0.5 * r, 1.2 * r, 3); x.fillText(s.code, lx + 1.5 * r, T + 0.6 * r + 3); lx += 7 * r; }); }
  if (mouse && mouse.x >= L && mouse.x <= L + cw && mouse.y >= T && mouse.y <= T + ch) {
    const i = Math.max(0, Math.min(n - 1, Math.round(((mouse.x - L) / cw) * (n - 1))));
    x.strokeStyle = "#5b6b82"; x.setLineDash([3, 3]); x.beginPath(); x.moveTo(Xi(i), T); x.lineTo(Xi(i), T + ch); x.moveTo(L, mouse.y); x.lineTo(L + cw, mouse.y); x.stroke(); x.setLineDash([]);
    let txt = fmtT(t[i]);
    series.forEach((s) => { txt += mode === "single" ? "   价 " + s.vals[i].toFixed(q0.decimals) + "   较窗口起点 " + pct((s.vals[i] / s.vals[0] - 1) * 100) : "   " + s.code + " " + pct(s.vals[i]); });
    x.fillStyle = "rgba(0,0,0,.75)"; x.fillRect(L + 0.4 * r, T + (mode === "compare" ? 1.7 * r : 0.2 * r), x.measureText(txt).width + r, 1.5 * r);
    x.fillStyle = "#fff"; x.fillText(txt, L + 0.9 * r, T + (mode === "compare" ? 1.7 * r : 0.2 * r) + 0.75 * r);
    const yv = mn + (1 - (mouse.y - T) / ch) * (mx - mn);
    x.fillStyle = "#2a3a50"; x.fillRect(L + cw, mouse.y - 0.7 * r, R - 0.2 * r, 1.4 * r); x.fillStyle = "#fff"; x.fillText(mode === "single" ? yv.toFixed(q0.decimals) : pct(yv), L + cw + 0.3 * r, mouse.y);
  }
}

