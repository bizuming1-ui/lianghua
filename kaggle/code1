        const arr = S.ticks[q.code]; if (arr && arr.length) arr[arr.length - 1][1] = q.price;
        changed = true;
      }
    });
    S.fastAt = Date.now();
    if (S.feed) { S.feed.latency = f.lat; S.feed.pollMs = f.pollMs; }
    if (changed) scheduleRender();
  } catch (e) { fastOn = false; return; } // Next 版没有 /api/fast:自动退回 1 秒轮询
