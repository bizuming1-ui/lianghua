def num(s):
    try:
        v = float(s)
        return v if math.isfinite(v) else 0.0
    except Exception:
        return 0.0


def parse_cn_time(date_s, time_s, fallback_ms):
    try:
        y, mo, d = [int(x) for x in date_s.split("-")]
        hh, mi, ss = [int(x) for x in time_s.split(":")]
        return zoned_ms(y, mo, d, hh, mi, ss, "CN")
    except Exception:
        return fallback_ms


