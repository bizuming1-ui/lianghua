class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj, ensure_ascii=False, separators=(",", ":")))

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        try:
            if u.path in ("/", "/site", "/index.html"):
                with open(INDEX_PATH, "rb") as f:
                    return self._send(200, f.read(), "text/html; charset=utf-8")
            if u.path == "/api/state":
                return self._json(build_state(int(float(q.get("since", ["0"])[0] or 0))))
            if u.path == "/api/trades":
                off = max(0, int(q.get("offset", ["0"])[0] or 0))
                lim = min(100000, max(1, int(q.get("limit", ["50"])[0] or 50)))
                return self._json(list_trades(off, lim))
            if u.path == "/api/health":
                return self._json({"ok": True, "ai": AI is not None, "persist": bool(PERSIST)})
            if u.path == "/api/fast":
                return self._json(build_fast())
            if u.path == "/api/persist":
                return self._json(PERSIST.status() if PERSIST else {"error": "持久化模块未加载"})
            if u.path == "/api/backup":
                data = json.dumps(dict(export_state(), saved_at=int(time.time() * 1000), version=2), ensure_ascii=False).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Disposition", 'attachment; filename="quant_state_%s.json"' % time.strftime("%Y%m%d_%H%M%S"))
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
            if u.path == "/api/indicators":
                if not AI:
                    return self._json({"ok": False, "error": "AI/指标模块未加载(缺少 numpy?)"}, 503)
                return self._json(AI.indicators(q.get("code", [""])[0], q.get("tf", ["5m"])[0]))
            if u.path == "/api/history":
                if not AI:
                    return self._json({"ok": False, "error": "AI/历史模块未加载(缺少 numpy?)"}, 503)
                return self._json(AI.history_bars(q.get("code", [""])[0], q.get("tf", ["5m"])[0]))
            if u.path == "/api/ai/state":
                if not AI:
                    return self._json({"available": False, "reason": "AI 模块未加载(缺少 numpy 或 ai_engine.py)"})
                return self._json(AI.state(full=q.get("full", ["0"])[0] == "1"))
            return self._send(404, "not found", "text/plain; charset=utf-8")
        except Exception as ex:
            return self._json({"error": str(ex)}, 500)

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or b"{}") if n else {}
        except Exception:
            return self._json({"ok": False, "error": "请求格式错误"}, 400)
        try:
            if u.path == "/api/trade":
                side = str(body.get("side", "")).upper()
                if side not in ("BUY", "SELL"):
                    return self._json({"ok": False, "error": "side 必须是 BUY 或 SELL"}, 400)
                qty = body.get("qty")
                try:
                    qty = int(qty)
                except Exception:
                    qty = 0
                r = execute(str(body.get("symbol", "")), side, qty, "manual")
                return self._json(r, 200 if r["ok"] else 400)
            if u.path == "/api/auto":
                mode = str(body.get("mode") or ("rule" if body.get("enabled") else "off")).lower()
                if mode not in ("off", "rule", "ai"):
                    return self._json({"ok": False, "error": "mode 必须是 off/rule/ai"}, 400)
                if mode == "ai":
                    if not AI:
                        return self._json({"ok": False, "error": "AI 模块未加载"}, 400)
                    if not ai_engine.llm_health()["up"]:
                        return self._json({"ok": False, "error": "大模型未就绪:请先运行 Cell 0(双卡 vLLM),看到『双卡同时工作』后再开启"}, 400)
                set_auto({"off": 0, "rule": 1, "ai": 2}[mode])
                return self._json({"ok": True, "mode": mode, "enabled": mode != "off"})
            if u.path == "/api/ai/run":
                if not AI:
                    return self._json({"ok": False, "error": "AI 模块未加载"}, 400)
                if not ai_engine.llm_health()["up"]:
                    return self._json({"ok": False, "error": "大模型未就绪"}, 400)
                AI.trigger(body.get("code") or None)
                return self._json({"ok": True})
            if u.path == "/api/reset":
                reset_account()
                return self._json({"ok": True})
            if u.path == "/api/restore":
                if not isinstance(body, dict) or not body.get("sql"):
                    return self._json({"ok": False, "error": "不是有效的备份文件(缺少 sql 段)"}, 400)
                import_state(body)
                dirty(True)
                return self._json({"ok": True, "trades": len((body.get("sql") or {}).get("trades") or [])})
            if u.path == "/api/persist/save":
                return self._json(dict(PERSIST.save_now(force=True), ok=True) if PERSIST else {"ok": False, "error": "持久化模块未加载"})
            return self._send(404, "not found", "text/plain; charset=utf-8")
        except Exception as ex:
            return self._json({"ok": False, "error": str(ex)}, 500)


