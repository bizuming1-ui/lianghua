    def _bg_loop(self):
        while True:
            try:
                for s in self.symbols:
                    self.refresh_study(s["code"])
                    for tf in ("5m", "1d"):
                        try:
                            self.inds.setdefault(s["code"], {})[tf] = self.indicators(s["code"], tf)
                        except Exception as ex:
