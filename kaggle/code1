        if 960 <= t < 1200:
            return "post"
        return "closed"
    if 570 <= t < 690 or 780 <= t < 900:
        return "open"
    if 690 <= t < 780:
        return "lunch"
    if 555 <= t < 570:
        return "pre"
    return "closed"


