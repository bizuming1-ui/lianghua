# ----------------------------- JSON 解析 -----------------------------
def extract_json(s):
    i = s.find("{")
    while i != -1:
        depth, instr, esc = 0, False, False
        for j in range(i, len(s)):
            ch = s[j]
            if instr:
                if esc:
                    esc = False
                elif ch == "\\":
                    esc = True
                elif ch == '"':
                    instr = False
            elif ch == '"':
                instr = True
            elif ch == "{":
                depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    try:
                        return json.loads(s[i:j + 1])
                    except Exception:
                        break
        i = s.find("{", i + 1)
    return None


def split_think(full):
    if "</think>" in full:
        a, b = full.split("</think>", 1)
        return a.replace("<think>", "").strip(), b.strip()
    return full.replace("<think>", "").strip(), ""


def clamp(v, lo, hi, default):
    try:
        v = float(v)
        if math.isnan(v):
            return default
        return max(lo, min(hi, v))
    except Exception:
        return default


