<script>
"use strict";
const $ = (id) => document.getElementById(id);
const TZ = "Asia/Shanghai";
const dtf = new Intl.DateTimeFormat("sv-SE", { timeZone: TZ, year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23" });
const fmtDT = (ms) => dtf.format(new Date(ms));
const fmtT = (ms) => fmtDT(ms).slice(11);
const rem = () => parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
const money = (v, sign) => (v == null || isNaN(v) ? "--" : (sign && v > 0 ? "+" : v < 0 ? "-" : "") + "¥" + Math.abs(v).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
const pct = (v, d) => (v == null || isNaN(v) ? "--" : (v > 0 ? "+" : "") + v.toFixed(d == null ? 2 : d) + "%");
const cls = (v) => (v > 0 ? "up" : v < 0 ? "dn" : "dim");
const CUR = { USD: "$", CNY: "¥" };
const MAXT = 7200;

const S = { epoch: 0, ticks: {}, q: [], sig: {}, acct: null, pos: [], stats: null, trades: [], fx: null, feed: null, last: {} };
let sel = "IBB", mode = "single", winN = 60, showMA = true, showBO = true, mouse = null, busy = false;
let colors = { up: "#ff3b4e", dn: "#19c37d" };
const CMP = { IBB: "#3ab4ff", XBI: "#f5b942", "159502": "#c77dff" };

function readColors() {
  const cs = getComputedStyle(document.body);
  colors.up = cs.getPropertyValue("--up").trim(); colors.dn = cs.getPropertyValue("--dn").trim();
}
function setCC(v) { document.body.dataset.cc = v; localStorage.setItem("cc", v); $("cc").textContent = v === "cn" ? "红涨绿跌" : "绿涨红跌"; readColors(); renderAll(); }
setCC(localStorage.getItem("cc") || "cn");

const qOf = (c) => S.q.find((x) => x.code === c);
const fp = (q, p) => (p == null ? "--" : p.toFixed(q ? q.decimals : 2));

/* ---------------- 数据拉取:每秒一次 ---------------- */
function sinceT() {
  let m = Infinity;
  for (const k in S.ticks) { const a = S.ticks[k]; m = Math.min(m, a.length ? a[a.length - 1][0] : 0); }
  return m === Infinity ? 0 : m;
}
async function loop() {
  const t0 = performance.now();
  try {
    const r = await fetch("/api/state?since=" + sinceT(), { cache: "no-store" });
    const s = await r.json();
    if (s.error) throw new Error(s.error);
    apply(s);
  } catch (e) {
    const f = $("feed"); f.innerHTML = '<i style="background:#ff3b4e"></i><span style="color:#ff3b4e">连接中断,重试中…</span>';
  }
  setTimeout(loop, Math.max(80, 1000 - (performance.now() - t0)));
}
function apply(s) {
  if (S.epoch && S.epoch !== s.epoch) S.ticks = {};
  S.epoch = s.epoch;
  const prev = {}; S.q.forEach((x) => (prev[x.code] = x.price));
  S.prevPx = prev;
  for (const c in s.ticks) {
    const arr = (S.ticks[c] = S.ticks[c] || []);
    for (const t of s.ticks[c]) { if (!arr.length || t[0] > arr[arr.length - 1][0]) arr.push(t); else if (t[0] === arr[arr.length - 1][0]) arr[arr.length - 1][1] = t[1]; }
    if (arr.length > MAXT) arr.splice(0, arr.length - MAXT);
  }
  if (s.ticks) for (const c in S.ticks) { if (!s.ticks[c]) continue; }
  if (res !== "tick" && mode === "single") loadHist(sel, res);
  S.q = s.quotes; S.sig = s.signals; S.acct = s.account; S.pos = s.positions; S.stats = s.stats; S.trades = s.trades; S.fx = s.fx; S.feed = s.feed; S.now = s.ts; S.fee = s.fee; S.persist = s.persist;
  renderAll(); renderBackup();
}

/* ---------------- 渲染 ---------------- */
function renderAll() {
  if (!S.acct) return;
  renderHeader(); renderCards(); renderCenter(); renderAccount(); renderTrade(); renderLog(); renderStats(); drawMain();
}
function renderHeader() {
  $("mkts").innerHTML = ["US", "CN"].map((m) => {
    const q = S.q.find((x) => x.market === m);
    return q ? '<span class="chip ' + q.state + '"><i></i>' + (m === "US" ? "美股 " : "A股 ") + q.stateLabel + "</span>" : "";
  }).join("");
  const f = S.feed, anySim = S.q.some((q) => q.feed === "sim"), anyStale = S.q.some((q) => q.feed === "stale");
  let h;
  if (anySim) h = '<i style="background:#f5b942"></i><span style="color:#f5b942">模拟行情(外网不可用,仅演示)</span>';
  else if (anyStale || !f.ok) h = '<i style="background:#f5b942"></i><span style="color:#f5b942">行情延迟 · ' + (f.error || "stale") + "</span>";
  else h = '<i style="background:#19c37d;box-shadow:0 0 .5rem #19c37d"></i><span>实时 · ' + f.name + " · " + f.latency + "ms · " + (fastOn && S.fastAt && Date.now() - S.fastAt < 1500 ? "毫秒级刷新(" + (f.pollMs || 500) + "ms 抓取/200ms 推送)" : "1秒刷新") + "</span>";
  $("feed").innerHTML = h;
  $("fx").textContent = "USD/CNY " + S.fx.rate.toFixed(4) + (S.fx.src === "default" ? " (兜底)" : "");
}
function renderCards() {
  const box = $("left");
  if (!box.children.length) {
    box.innerHTML = S.q.map((q) => '<div class="panel card" data-code="' + q.code + '"><div class="r1"><span class="code">' + q.code + '</span><span class="chip st"></span></div><div class="nm">' + q.name + '</div><div class="px mono"></div><div class="chg mono"></div><canvas></canvas><div class="mini mono"></div><div class="pos"></div></div>').join("");
    box.addEventListener("click", (e) => { const c = e.target.closest(".card"); if (c) { sel = c.dataset.code; $("qty").value = qOf(sel).lot; V.off = 0; G.anchorT = 0; if (res !== "tick") loadHist(sel, res, true); renderAll(); renderAI(); } });
  }
  S.q.forEach((q, i) => {
    const el = box.children[i];
    el.classList.toggle("sel", q.code === sel);
    const st = el.querySelector(".st"); st.className = "chip st " + q.state; st.innerHTML = "<i></i>" + q.stateLabel;
    const px = el.querySelector(".px"); const txt = CUR[q.currency] + fp(q, q.price);
    if (px.textContent !== txt) {
      const pv = S.prevPx && S.prevPx[q.code];
      px.textContent = txt;
      if (pv != null && q.price !== pv) { px.classList.remove("flash-up", "flash-dn"); void px.offsetWidth; px.classList.add(q.price > pv ? "flash-up" : "flash-dn"); }
    }
    px.className = "px mono " + cls(q.change) + (px.classList.contains("flash-up") ? " flash-up" : px.classList.contains("flash-dn") ? " flash-dn" : "");
    const ch = el.querySelector(".chg"); ch.className = "chg mono " + cls(q.change);
    ch.textContent = (q.change > 0 ? "+" : "") + fp(q, q.change) + "  " + pct(q.pct);
    el.querySelector(".mini").innerHTML = "<span>开 " + fp(q, q.open) + "</span><span>昨收 " + fp(q, q.prevClose) + "</span><span>高 " + fp(q, q.high) + "</span><span>低 " + fp(q, q.low) + "</span><span style='grid-column:1/3'>报价时间 " + (q.quoteTime ? fmtDT(q.quoteTime).slice(5) : "--") + "</span>";
    const p = S.pos.find((x) => x.symbol === q.code);
    el.querySelector(".pos").innerHTML = p ? '持仓 <b class="mono">' + p.qty + '</b> · 浮盈 <span class="mono ' + cls(p.pnlCny) + '">' + money(p.pnlCny, 1) + " (" + pct(p.pnlPct * 100) + ")</span>" : "无持仓";
    spark(el.querySelector("canvas"), q);
  });
}
function spark(cv, q) {
  const { x, w, h } = prep(cv); x.clearRect(0, 0, w, h);
  const a = (S.ticks[q.code] || []).slice(-180); if (a.length < 2) return;
  let mn = Infinity, mx = -Infinity; a.forEach((t) => { mn = Math.min(mn, t[1]); mx = Math.max(mx, t[1]); });
  if (mx === mn) { mx += 1e-6; mn -= 1e-6; }
  const col = q.change >= 0 ? colors.up : colors.dn;
  x.beginPath(); a.forEach((t, i) => { const X = (i / (a.length - 1)) * w, Y = h - 2 - ((t[1] - mn) / (mx - mn)) * (h - 4); i ? x.lineTo(X, Y) : x.moveTo(X, Y); });
  x.strokeStyle = col; x.lineWidth = 1.5; x.stroke();
  x.lineTo(w, h); x.lineTo(0, h); x.closePath();
  const g = x.createLinearGradient(0, 0, 0, h); g.addColorStop(0, col + "44"); g.addColorStop(1, col + "00"); x.fillStyle = g; x.fill();
}
function renderCenter() {
  const q = qOf(sel); if (!q) return;
  $("ctitle").innerHTML = q.code + ' <span class="dim" style="font-size:.85rem;font-weight:400">' + q.name + "</span>";
  const px = $("cpx"); px.textContent = CUR[q.currency] + fp(q, q.price); px.className = "px mono " + cls(q.change);
  const ch = $("cchg"); ch.textContent = (q.change > 0 ? "+" : "") + fp(q, q.change) + "  " + pct(q.pct); ch.className = "mono " + cls(q.change);
  const s = S.sig[sel];
  const f = (v, d) => (v == null ? "--" : v.toFixed(d));
